  remote: {
  	cache : false,
    url: 'http://ucsweb.ift.org.mx/vrpc/index.php/RpcServicesController/searchBP?query=%QUERY',
    wildcard: '%QUERY'
  }
});

$('#concesionario-remote-search .typeahead').typeahead({minLength: 3,
  highlight: true}, {
  name: 'best-cedentes',
  limit: 20,
  items: 20,
  display: 'concesionario',
  source: bestBps,
  templates: {
    empty: [
      '<div class="empty-message">',
        'Concesionarioo inexistente',
      '</div>'
    ].join('\n')
  }
});

$('#concesionario-remote-search').on('change', function() {
  var $input = $(this);
  try {
  	var available = $input.data('ttView').datasets[0].itemHash;
  	var datum = _.findWhere(available, {value: $(this).val()});
  	if (datum) {
    	$input.trigger('typeahead:selected', datum);
  	}
  } catch(e) {
  	$input.trigger('typeahead:uservalue', '');
  }
});

$('#concesionario-remote-search').on('typeahead:select', function(ev, suggestion) {
  console.log('Selection: ' + suggestion.concesionario+"->"+suggestion.idBp);
   $("#txtBPConcesionario").val(suggestion.idBp);
});

$('#concesionario-remote-search').on('typeahead:uservalue', function(e, value) { 
	console.log('new: [' + value+']'); 
	$("#txtBPConcesionario").val('');
});


